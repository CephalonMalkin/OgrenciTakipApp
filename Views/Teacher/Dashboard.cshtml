@model IEnumerable<OgrenciTakipApp.Models.Student>

@{
    ViewData["Title"] = "Sınıf Takip Paneli";
    var teacher = ViewBag.Teacher as OgrenciTakipApp.Models.Teacher;
    string selectedDate = ViewBag.SelectedDate ?? "";
    string displayDate = ViewBag.DisplayDate ?? "";
    int totalCount = Model.Count();
    int readCount = Model.Count(s => s.DailyReadings != null && s.DailyReadings.Any(r => r.IsRead));
}

<div class="container py-3">
    <!-- Üst Başlık & İşlem Butonları -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3 pb-3 border-bottom">
        <div>
            <h4 class="text-white fw-bold mb-0">Hoş Geldiniz, <span class="text-info">@(teacher?.FullName ?? "Öğretmen")</span></h4>
            <span class="badge bg-secondary">Öğretmen Paneli</span>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="CreateStudent" asp-route-teacherId="@teacher?.Id" class="btn btn-success btn-sm d-flex align-items-center gap-1">
                <span>➕</span> Yeni Öğrenci
            </a>
            <a asp-action="Login" class="btn btn-outline-danger btn-sm">Çıkış</a>
        </div>
    </div>

    <!-- Filtre & İstatistik Kartı -->
    <div class="row g-3 mb-4">
        <!-- Tarih Seçici -->
        <div class="col-12 col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-3">
                    <form method="get" asp-action="Dashboard" class="row g-2 align-items-end">
                        <input type="hidden" name="teacherId" value="@teacher?.Id" />
                        <div class="col-8">
                            <label class="form-label small fw-bold text-muted mb-1">Tarih Seç / Geçmişi İncele</label>
                            <input type="date" name="selectedDate" value="@selectedDate" class="form-control" />
                        </div>
                        <div class="col-4">
                            <button type="submit" class="btn btn-primary w-100">Listele</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Günlük Özet Sayaç -->
<div class="col-12 col-md-6">
    <div class="card shadow-sm border-0 h-100">
        <div class="card-body p-3 d-flex justify-content-around align-items-center text-center">
            <div>
                <div class="small opacity-75" style="color: #94a3b8 !important;">İncelenen Gün</div>
                <div class="fw-bold fs-6" style="color: #38bdf8 !important;">@displayDate</div>
            </div>
            <div class="vr opacity-25"></div>
            <div>
                <div class="small opacity-75" style="color: #94a3b8 !important;">Okuyan Öğrenci</div>
                <div class="fw-bold text-success fs-5">@readCount / @totalCount</div>
            </div>
        </div>
    </div>
</div>
    <!-- Excel İle Toplu Öğrenci Yükleme Kutusu -->
<div class="card mb-4">
    <div class="card-body">
        <h5 class="fw-bold mb-3">📑 Excel ile Toplu Öğrenci Ekle</h5>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success py-2">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger py-2">@TempData["Error"]</div>
        }

        <div class="d-flex flex-wrap align-items-center gap-3">
            <a asp-action="DownloadTemplate" class="btn btn-outline-info btn-sm">
                📥 Şablon İndir (.xlsx)
            </a>

            <form asp-action="UploadExcel" method="post" enctype="multipart/form-data" class="d-flex gap-2 align-items-center m-0">
                <input type="hidden" name="teacherId" value="@ViewBag.Teacher.Id" />
                <input type="file" name="excelFile" accept=".xlsx, .xls" class="form-control form-control-sm" required style="max-width: 250px;" />
                <button type="submit" class="btn btn-primary btn-sm">
                    🚀 Yükle
                </button>
            </form>
        </div>
    </div>
</div>

    <!-- Sınıf Listesi Tablosu (Mobilde kaydırılabilir) -->
<div class="card shadow-sm border-0">
    <div class="card-header py-3 bg-transparent border-bottom">
        <h6 class="mb-0 fw-bold" style="color: #38bdf8 !important;">Sınıf Listesi & Okuma Durumu</h6>
    </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 100px;">Okul No</th>
                        <th>Öğrenci Adı</th>
                        <th style="width: 120px;">Erişim PIN</th>
                        <th class="text-center" style="width: 130px;">Durum</th>
                        <th class="text-end" style="width: 140px;">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                Henüz sınıfa eklenmiş öğrenci bulunmuyor.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var student in Model)
                        {
                            bool hasRead = student.DailyReadings != null && student.DailyReadings.Any(r => r.IsRead);
                            <tr>
                                <td class="fw-bold">@student.StudentNumber</td>
                                <td>@student.FullName</td>
                                <td><span class="badge bg-light text-dark border">@student.AccessPin</span></td>
                                <td class="text-center">
                                    @if (hasRead)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1">✔ Okundu</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-muted border px-2 py-1">Okunmadı</span>
                                    }
                                </td>
                                <td class="text-end">
    <div class="d-inline-flex gap-1">
        <a asp-action="StudentHistory" asp-route-id="@student.Id" class="btn btn-outline-primary btn-sm">
            📊 Geçmiş
        </a>
        <form asp-action="DeleteStudent" method="post" onsubmit="return confirm('@student.FullName isimli öğrenciyi ve tüm okuma kayıtlarını silmek istediğinize emin misiniz?');">
            <input type="hidden" name="id" value="@student.Id" />
            <input type="hidden" name="teacherId" value="@teacher?.Id" />
            <button type="submit" class="btn btn-outline-danger btn-sm">
                🗑️ Sil
            </button>
        </form>
    </div>
</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>