@{
    ViewData["Title"] = "Öğretmen Girişi";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h5 class="mb-0">Öğretmen Yönetim Paneli</h5>
                    <small class="text-light-50">Sistem Girişi</small>
                </div>
                <div class="card-body p-3 p-md-4">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger py-2 small" role="alert">
                            @ViewBag.Error
                        </div>
                    }

                    <form asp-action="Login" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Kullanıcı Adı</label>
                            <input type="text" name="username" class="form-control form-control-lg" placeholder="Örn: ogretmen" required autofocus />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Şifre</label>
                            <input type="password" name="password" class="form-control form-control-lg" placeholder="Şifreniz" required />
                        </div>

                        <button type="submit" class="btn btn-dark btn-lg w-100 shadow-sm">
                            Giriş Yap
                        </button>
                    </form>
                </div>
                <div class="card-footer text-center bg-light py-2">
                    <a asp-controller="Parent" asp-action="Login" class="text-decoration-none small text-secondary">
                        ← Veli Girişine Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>