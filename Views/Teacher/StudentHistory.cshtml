@model OgrenciTakipApp.Models.Student

@{
    ViewData["Title"] = "Öğrenci Okuma Geçmişi";
    int readDays = Model.DailyReadings?.Count(r => r.IsRead) ?? 0;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-7">
            <!-- Öğrenci Künye Kartı -->
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-body p-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0 fw-bold text-primary">@Model.FullName</h5>
                        <small class="text-muted">Okul No: @Model.StudentNumber | PIN: @Model.AccessPin</small>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-success fs-6">Toplam: @readDays Gün</span>
                    </div>
                </div>
            </div>

            <!-- Geçmiş Kayıt Listesi -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <h6 class="mb-0 fw-bold">Okuma Kayıtları (Son Okunan Günler)</h6>
                    <a asp-action="Dashboard" asp-route-teacherId="@Model.TeacherId" class="btn btn-outline-secondary btn-sm">
                        ← Sınıfa Dön
                    </a>
                </div>
                <ul class="list-group list-group-flush">
                    @if (Model.DailyReadings != null && Model.DailyReadings.Any())
                    {
                        @foreach (var record in Model.DailyReadings)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                                <div>
                                    <span class="fw-semibold">📅 @record.ReadingDate.ToString("dd.MM.yyyy")</span>
                                    <span class="text-muted small ms-2">(@record.MarkedAt.ToString("HH:mm"))</span>
                                </div>
                                <span class="badge bg-success rounded-pill">Kitap Okundu</span>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item text-center text-muted py-4">
                            Bu öğrenciye ait henüz bir okuma kaydı bulunmuyor.
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>